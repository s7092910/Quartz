<ModSettings version="2">
	<Global>
		<Tab name="General">
			<Category name="General" displayKey="quartzSettingGeneral">
				<Description key="quartzSettingGeneralTooltip" />
				
				<Selector name="TextResolution" displayKey="quartzSettingTextResolution" type="Quartz.Settings.GlobalSettings+TextResolution, Quartz" defaultValue="High">
					<Description key="quartzSettingTextResolutionTooltip" />
					<LocalizationPrefix prefix="quartzSettingPrefixTextRes" />
				</Selector>
			</Category>
		</Tab>
		<Tab name="Minimap">
			<Category name="Minimap" displayKey="quartzSettingMinimap" tooltipKey="quartzSettingMinimapTooltip">
				<Description key="quartzSettingMinimapTooltip" />
				
				<Switch name="MinimapShowOrHide" displayKey="quartzSettingMinimapShow" type="bool" defaultValue="true">
					<Description key="quartzSettingMinimapShowTooltip" />
					<LocalizationPrefix prefix="quartzSettingPrefixShowHide" />
				</Switch>
				<Switch name="IconsShowOrHide" displayKey="quartzSettingMinimapIconsShow" type="bool" defaultValue="true">
					<Description key="quartzSettingMinimapIconsShowTooltip" />
					<LocalizationPrefix prefix="quartzSettingPrefixShowHide" />
				</Switch>
				<Switch name="TextShowOrHide" displayKey="quartzSettingMinimapTextShow" type="bool" defaultValue="true">
					<Description key="quartzSettingMinimapTextShowTooltip" />
					<LocalizationPrefix prefix="quartzSettingPrefixShowHide" />
				</Switch>
				<Switch name="MinimapIconsShowOrHide" displayKey="quartzSettingMinimapIconsOnlyShow" type="bool" defaultValue="true">
					<Description key="quartzSettingMinimapIconsOnlyShowTooltip" />
					<LocalizationPrefix prefix="quartzSettingPrefixShowHide" />
				</Switch>
				<Switch name="RotateWithPlayer" displayKey="quartzSettingMinimapRotateWithPlayer" type="bool" defaultValue="false">
					<Description key="quartzSettingMinimapRotateWithPlayerTooltip" />
					<LocalizationPrefix prefix="quartzSettingPrefixRotate" />
				</Switch>
				
				<Slider name="IconScale" displayKey="quartzSettingMinimapIconScale" type="float" defaultValue="100%">
					<Description key="quartzSettingMinimapIconScaleTooltip" />
					<Incremental increment="1%" minValue="50%" maxValue="200%"/>
					<Formatter ui="0%" serialize="0.00" />
				</Slider>
				<Slider name="IconOpacity" displayKey="quartzSettingMinimapIconOpacity" type="float" defaultValue="100%">
					<Description key="quartzSettingMinimapIconOpacityTooltip" />
					<Incremental increment="1%" minValue="0%" maxValue="100%"/>
					<Formatter ui="0%" serialize="0.00" />
				</Slider>
				<Slider name="TextureOpacity" displayKey="quartzSettingMinimapTextureOpacity" type="float" defaultValue="100%">
					<Description key="quartzSettingMinimapTextureOpacityTooltip" />
					<Incremental increment="1%" minValue="0%" maxValue="100%"/>
					<Formatter ui="0%" serialize="0.00" />
				</Slider>
			</Category>
			<Category name="KeyBindings" displayKey="quartzSettingKeybinding">
				<Description key="quartzSettingInputMinimapKeybindingTooltip" />
				
				<Binding name="EnabledKeyBinding" displayKey="quartzSettingInputMinimapToggle">
					<Description key="quartzSettingInputMinimapToggleTooltip" />
				</Binding>
				<Binding name="ZoomInKeyBinding" displayKey="quartzSettingInputMinimapZoomIn">
					<Description key="quartzSettingInputMinimapZoomInTooltip" />
				</Binding>
				<Binding name="ZoomOutKeyBinding" displayKey="quartzSettingInputMinimapZoomOut">
					<Description key="quartzSettingInputMinimapZoomOutTooltip" />
				</Binding>
			</Category>
		</Tab>
		<Tab name="Inventory">
			<Category name="KeyBindings" displayKey="quartzSettingKeybinding">
				<Description key="quartzSettingInputInventoryKeybindingTooltip" />
				
				<Binding name="LockedSlots" displayKey="quartzSettingInputLockedSlots">
					<Description key="quartzSettingInputLockedSlotsTooltip" />
				</Binding>
			</Category>
		</Tab>
		<Tab name="Dev Tools">
			<Category name="Debug" displayKey="quartzSettingDebug">
				<Description key="quartzSettingDebugTooltip" />
				
				<Switch name="DebugMode" displayKey="quartzSettingDebugMode" type="bool" defaultValue="false">
					<Description key="quartzSettingDebugModeTooltip" />
					<LocalizationPrefix prefix="quartzSettingPrefixShowHide" />
				</Switch>
			</Category>
		</Tab>
	</Global>
</ModSettings>